{
  "name": "thethinkingobservatory-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Socratic learning observatory for quantitative reasoning and Jane Street preparation.",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "dev": "node scripts/tutor-server.mjs",
    "start": "node scripts/tutor-server.mjs",
    "preview:static": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "deploy": "npm run check && npm run build:production && cf deploy --prebuilt",
    "build:production": "node scripts/build-worker.mjs"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.31"
  }
}
